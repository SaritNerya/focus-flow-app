# העתיקו ל-.env. אין כאן סודות אמיתיים.
# כתובת מסד הנתונים נקבעת ב-docker-compose.yml (MONGO_URL=mongodb://mongo:27017)
MONGO_DB=focusflow

# סוד החתימה של הטוקנים. מחליפים בערך אקראי ארוך:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_JWT=replace-me-with-a-long-random-string
JWT_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:3000

# הגנה על חשבון
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_REQUIRE_MIXED=false

# אופציונלי: נשאר ריק בהגשה. האתר חייב לעבוד גם בלי זה
GEMINI_API_KEY=
