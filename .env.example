# העתיקו ל-.env. אין כאן סודות אמיתיים.
# כתובת מסד הנתונים נקבעת ב-docker-compose.yml (MONGO_URL=mongodb://mongo:27017)
MONGO_DB=focusflow

# סוד החתימה של הטוקנים — חובה, לפחות 32 תווים (בלעדיו השרת לא עולה). מחליפים בערך אקראי ארוך:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_JWT=replace-me-with-a-long-random-string
JWT_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:3000

# הגנה על חשבון
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_REQUIRE_MIXED=true

# הגבלת קצב לפי IP על התחברות והרשמה (בקשות לדקה, לכל נתיב)
RATE_LIMIT_PER_MINUTE=20
# כמה פרוקסים מהימנים לפני השרת: 0 = Docker מקומי (ברירת מחדל), 1 = Cloud Run, 2 = Load Balancer + Cloud Run
TRUSTED_PROXY_HOPS=0

# התחברות עם Google: ה-Client ID מ-Google Cloud Console (אינו סוד). ריק = הכפתור לא מוצג
GOOGLE_CLIENT_ID=

# אופציונלי: נשאר ריק בהגשה. האתר חייב לעבוד גם בלי זה
GEMINI_API_KEY=
